module mathf

# Floating-point math, the "integer-only math" gap closed. fabs/fmin/fmax + fsqrt via Newton's
# method, and fsin/fcos/ftan via range-reduced Taylor series (no math.h). f64 params are annotated;
# the loop counter stays i32 (separate banks). Differential-checkable vs the machine: fsqrt(2.0)
# converges to sqrt(2); fsin/fcos match Math.sin/cos to ~1e-9 across [-2pi, 2pi].

pub fn fabs(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x

pub fn fmin(a: f64, b: f64) -> f64:
    if a < b:
        return a
    return b

pub fn fmax(a: f64, b: f64) -> f64:
    if a > b:
        return a
    return b

# square root by Newton iteration g <- (g + x/g)/2 (x > 0; returns 0 for x <= 0)
# |g*g - x| computed ACCURATELY via a Veltkamp split + 2Prod (Dekker), so g*g carries no rounding
# error into the residual. Lets fsqrt pick the correctly-rounded neighbour. (No FMA / opcode needed.)
fn _sq_absresid(g: f64, x: f64) -> f64:
    let p = g * g
    let c = 134217729.0 * g
    let gh = c - (c - g)
    let gl = g - gh
    let lo = ((gh * gh - p) + 2.0 * gh * gl) + gl * gl
    let r = (p - x) + lo
    if r < 0.0:
        return 0.0 - r
    return r

# (one scratch word for fsqrt's bits: a block of its own on every call was never given back -- 8
# bytes a call, which filled a 512 MB heap in 300 training steps of 217 thousand square roots each)
let SQRT_BITS = alloc(8)

pub fn fsqrt(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    let g = x
    let i = 0
    while i < 30:
        g = (g + x / g) / 2.0
        i = i + 1
    # Newton lands within ~1 ULP; correctly-round by choosing whichever of g and its two f64
    # neighbours has the smallest accurate residual |y*y - x| (nextafter via bit +/- 1).
    let buf = SQRT_BITS
    storef(buf, g)
    let bits = load64(buf)
    let best = g
    let bestd = _sq_absresid(g, x)
    store64(buf, bits - i64(1))
    let gd = loadf(buf)
    let dd = _sq_absresid(gd, x)
    if dd < bestd:
        best = gd
        bestd = dd
    store64(buf, bits + i64(1))
    let gu = loadf(buf)
    let du = _sq_absresid(gu, x)
    if du < bestd:
        best = gu
    return best

# sin via range reduction to [-pi/2, pi/2] then a 7-term Taylor series. Closes the float-trig gap
# (mathf had none). Range reduction is by repeated 2pi subtraction, so very large |x| is slow but exact.
pub fn fsin(x: f64) -> f64:
    let r = x
    while r > 3.141592653589793:
        r = r - 6.283185307179586
    while r < 0.0 - 3.141592653589793:
        r = r + 6.283185307179586
    if r > 1.5707963267948966:
        r = 3.141592653589793 - r
    if r < 0.0 - 1.5707963267948966:
        r = (0.0 - 3.141592653589793) - r
    let r2 = r * r
    let term = r
    let sum = r
    term = 0.0 - term * r2 / 6.0
    sum = sum + term
    term = 0.0 - term * r2 / 20.0
    sum = sum + term
    term = 0.0 - term * r2 / 42.0
    sum = sum + term
    term = 0.0 - term * r2 / 72.0
    sum = sum + term
    term = 0.0 - term * r2 / 110.0
    sum = sum + term
    term = 0.0 - term * r2 / 156.0
    sum = sum + term
    term = 0.0 - term * r2 / 210.0
    sum = sum + term
    return sum

# cos(x) = sin(x + pi/2)
pub fn fcos(x: f64) -> f64:
    return fsin(x + 1.5707963267948966)

# tan(x) = sin/cos; returns 0.0 near the poles (|cos| < 1e-12) instead of blowing up
pub fn ftan(x: f64) -> f64:
    let c = fcos(x)
    if fabs(c) < 0.000000000001:
        return 0.0
    return fsin(x) / c

# truncate toward zero (drop the fractional part); exact for |x| < 2^52. Helper for floor/ceil/round.
fn _ftrunc(x: f64) -> f64:
    let neg = 0
    let v = x
    if v < 0.0:
        neg = 1
        v = 0.0 - v
    if v >= 4503599627370496.0:            # >= 2^52: already integral in f64
        return x
    let t = 0.0
    if v < 2147483648.0:                   # fits i32
        t = f64(i32(v))
    else:                                  # [2^31, 2^52): 2^26-aligned high part (exact) + i32 low
        let scale = 67108864.0
        let hi = f64(i32(v / scale))
        let lo = v - hi * scale
        t = hi * scale + f64(i32(lo))
    if neg == 1:
        return 0.0 - t
    return t

# largest integer <= x
pub fn ffloor(x: f64) -> f64:
    let t = _ftrunc(x)
    if x < 0.0 and t != x:
        return t - 1.0
    return t

# smallest integer >= x
pub fn fceil(x: f64) -> f64:
    let t = _ftrunc(x)
    if x > 0.0 and t != x:
        return t + 1.0
    return t

# round to nearest, ties away from zero (C round())
pub fn fround(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - ffloor((0.0 - x) + 0.5)
    return ffloor(x + 0.5)

# e^x. Range-reduce x = k*ln2 + r (|r| <= ln2/2); exp = 2^k * exp(r), exp(r) via Taylor (r small).
pub fn fexp(x: f64) -> f64:
    let ln2 = 0.6931471805599453
    let k = fround(x / ln2)
    let r = x - k * ln2
    let term = 1.0
    let sum = 1.0
    let n = 1
    while n <= 14:
        term = term * r / f64(n)
        sum = sum + term
        n = n + 1
    let ki = i32(k)
    let p = 1.0
    if ki >= 0:
        let i = 0
        while i < ki:
            p = p * 2.0
            i = i + 1
    else:
        let i = 0
        while i < (0 - ki):
            p = p / 2.0
            i = i + 1
    return sum * p

# natural log ln(x), x > 0 (returns 0.0 for x <= 0). Factor x = m*2^k, m in [1,2); ln(x) = k*ln2 + ln(m),
# ln(m) via the atanh series 2*(t + t^3/3 + t^5/5 + ...) with t = (m-1)/(m+1) (|t| <= 1/3, fast).
pub fn flog(x: f64) -> f64:
    if x <= 0.0:
        return 0.0
    let ln2 = 0.6931471805599453
    let m = x
    let k = 0
    while m >= 2.0:
        m = m / 2.0
        k = k + 1
    while m < 1.0:
        m = m * 2.0
        k = k - 1
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    let term = t
    let sum = t
    let n = 3
    while n <= 21:
        term = term * t2
        sum = sum + term / f64(n)
        n = n + 2
    return f64(k) * ln2 + 2.0 * sum

# base^exp. Integer exponents (|exp| <= 1024) use EXACT repeated multiplication (so fpow(2,10)=1024
# exactly); fractional exponents use exp(exp*log(base)) and require base > 0. fpow(x,0)=1.
pub fn fpow(base: f64, exp: f64) -> f64:
    if exp == 0.0:
        return 1.0
    if exp == _ftrunc(exp) and fabs(exp) <= 1024.0:
        let e = i32(exp)
        let neg = 0
        if e < 0:
            neg = 1
            e = 0 - e
        let r = 1.0
        let i = 0
        while i < e:
            r = r * base
            i = i + 1
        if neg == 1:
            return 1.0 / r
        return r
    if base <= 0.0:
        return 0.0
    return fexp(exp * flog(base))
